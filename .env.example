# Database (Neon Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# AI Gateway
# Prefer Vercel OIDC in production (`vercel env pull` locally).
# Use AI_GATEWAY_API_KEY for local/CI when OIDC is unavailable.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5-mini
AI_PLANNING_MODEL=openai/gpt-5-mini
AI_MONTHLY_BUDGET_USD=5
# Optional hard cap across all kitchens this month
AI_GLOBAL_MONTHLY_BUDGET_USD=
AI_CHAT_HOURLY_LIMIT=10
AI_CHAT_DAILY_LIMIT=40
# Lifetime chef-chat cap for UI Create account kitchens (demo)
AI_SELF_SIGNUP_CHAT_LIMIT=3

# Household defaults (used when creating kitchens)
HOUSEHOLD_NAME=Home
HOUSEHOLD_TIMEZONE=America/New_York

# Web panel — passcode accounts live in Postgres
# Create account on /login = demo kitchen; full kitchen: scripts/create-household.ts
# Generate: openssl rand -base64 32
WEB_PANEL_SESSION_KEY=
# Optional one-time bootstrap for the first kitchen without a passcode
WEB_PANEL_SECRET=

# Public app URL (used for Kroger OAuth redirects)
APP_BASE_URL=http://localhost:3000

# Harris Teeter via Kroger Public API (developer.kroger.com)
# Use YOUR own developer app — never copy another deploy’s Kroger secrets.
# Demo (self-signup) kitchens cannot Shop even when these are set.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Must match a redirect URI registered on your Kroger developer app:
KROGER_REDIRECT_URI=http://localhost:3000/api/kroger/callback
# Your store location ID from the Kroger location API (required for Shop)
KROGER_LOCATION_ID=
# Optional display name when location ID is set
KROGER_LOCATION_NAME=
# Optional — used only to discover a store when KROGER_LOCATION_ID is unset
HARRIS_TEETER_ZIP=
HARRIS_TEETER_STORE_NAME=
